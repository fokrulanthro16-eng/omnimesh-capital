# OmniMesh Capital - Environment Variables Template
# Copy this file to .env.local and populate with your credentials

# Nebius AI Studio API Key (for Meta-Llama-3.1-70B-Instruct & Gemma inference)
NEBIUS_API_KEY=your_nebius_api_key_here

# Hugging Face Inference API Key (for ProsusAI/finbert credit sentiment auditing)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HF_API_KEY=your_huggingface_api_key_here

# Node Environment
NODE_ENV=development
PORT=3000
